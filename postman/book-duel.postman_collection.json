{
  "info": {
    "_postman_id": "43c70573-99b6-4d09-bc2b-abb854f199d5",
    "name": "Book Duel API - Authentication and Existing Modules",
    "description": "Run the complete collection in order after npm run db:reset. Login requests save tokens automatically. Each request name starts with its expected HTTP status; failing cases end with the expected error code. Collection-level scripts assert these expectations and check that password fields are absent. Uses the current account, question-set, session and player endpoints. Full gameplay will be added later.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{hostToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1",
      "type": "string"
    },
    {
      "key": "demoPassword",
      "value": "BookDuel-Demo-2026",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const usedCodes = ['482613'].concat(['sessionCode','gameA','gameB'].map(key => String(pm.collectionVariables.get(key))));",
          "let absentCode = 999999;",
          "while (usedCodes.includes(String(absentCode))) absentCode--;",
          "pm.collectionVariables.set('missingCode', String(absentCode));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedParts = pm.info.requestName.split(' | ');",
          "const expectedStatus = Number(expectedParts[0]);",
          "pm.test('HTTP ' + expectedStatus, () => pm.response.to.have.status(expectedStatus));",
          "if (expectedStatus !== 204) {",
          "  const responseBody = pm.response.json();",
          "  if (expectedStatus >= 400) {",
          "    pm.test('Specific error code', () => pm.expect(responseBody.error.code).to.eql(expectedParts[2]));",
          "    pm.test('Readable error without stack trace', () => pm.expect(typeof responseBody.error.message === 'string' && responseBody.error.message.length > 0 && !Object.prototype.hasOwnProperty.call(responseBody, 'stack') && !Object.prototype.hasOwnProperty.call(responseBody.error, 'stack')).to.eql(true));",
          "  }",
          "  function containsPasswordField(value) {",
          "    return value !== null && typeof value === 'object' && Object.keys(value).some(key => key === 'password' || key === 'password_hash' || containsPasswordField(value[key]));",
          "  }",
          "  pm.test('No password fields returned', () => pm.expect(containsPasswordField(responseBody)).to.eql(false));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Log in - run this folder first",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "200 | L01 Log in administrator",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"school_id\":\"2099-9000\",\"password\":\"{{demoPassword}}\"}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now() + '-' + Math.floor(Math.random() * 1000000);",
                  "const suffix = 3000 + Math.floor(Math.random() * 5000);",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('newSchoolId', '2099-' + suffix);",
                  "pm.collectionVariables.set('newSchoolId2', '2099-' + (suffix + 1));",
                  "pm.collectionVariables.set('newSchoolId3', '2099-' + (suffix + 2));",
                  "pm.collectionVariables.set('newEmail', 'reader.' + runId + '@bookduel.test');",
                  "['adminToken','hostToken','otherHostToken','playerToken','secondPlayerToken','registeredToken','tamperedToken','adminId','hostId','registeredUserId','setId','sessionSetId','sessionCode','gameA','gameB','seatId','seatScore','seatHp','wrongLoginError'].forEach(key => pm.collectionVariables.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loginData = pm.response.json();",
                  "pm.test('Bearer JWT returned', () => pm.expect(loginData.token_type === 'Bearer' && typeof loginData.token === 'string' && loginData.token.split('.').length === 3).to.eql(true));",
                  "pm.test('Expected account and role', () => pm.expect(loginData.user.school_id === '2099-9000' && loginData.user.role === 'ADMIN').to.eql(true));",
                  "pm.collectionVariables.set('adminToken', loginData.token);",
                  "pm.collectionVariables.set('adminId', loginData.user.user_id);"
                ]
              }
            }
          ]
        },
